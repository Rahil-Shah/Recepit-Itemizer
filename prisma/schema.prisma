generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  name                String?
  passwordHash        String?
  // Optional per-user Gemini API key, stored encrypted at rest (AES-256-GCM:
  // ciphertext + iv + auth tag) exactly like Plaid tokens. Never returned to
  // the browser; when unset, the server falls back to the shared .env key.
  geminiKeyCiphertext String?
  geminiKeyIv         String?
  geminiKeyAuthTag    String?
  receipts            Receipt[]
  sessions            Session[]
  bankConnections     BankConnection[]
  accountPeople       AccountPerson[]
  rentEntries         RentEntry[]
  itemAliases         ItemAlias[]
  apiTokens           ApiToken[]
  oauthCodes          OAuthCode[]
  oauthGrants         OAuthGrant[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// A personal access token, for an AI assistant (or a script) that reaches the
// account through the MCP endpoint (server/mcp.mjs). It opens nothing else:
// the rest of the API only takes sessions. Only the SHA-256 of the token is
// kept, like a session's; `prefix` is the first few characters, shown in
// Settings so the owner can tell their tokens apart. `scopes` is a space-
// separated list ("receipts:read receipts:write").
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(80)
  tokenHash  String    @unique
  prefix     String
  scopes     String
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_tokens")
}

// An OAuth client registered through dynamic client registration (RFC 7591),
// such as claude.ai adding Receipt Ring as a connector. Registration is open,
// so a client is only a name and the redirect URIs it may be sent back to; it
// can do nothing until a signed-in user approves it on the consent page.
// clientSecretHash is set only for clients that asked for a secret.
// approvedAt is when someone first approved it: a client nobody approved is
// swept after a day, one that was approved is kept so it can reconnect.
model OAuthClient {
  id               String       @id @default(cuid())
  clientId         String       @unique
  clientSecretHash String?
  name             String       @db.VarChar(100)
  redirectUris     String[]
  approvedAt       DateTime?
  codes            OAuthCode[]
  grants           OAuthGrant[]
  createdAt        DateTime     @default(now())

  @@index([createdAt])
  @@map("oauth_clients")
}

// A one-time authorization code, valid for a few minutes, bound to the client,
// redirect URI and PKCE challenge it was issued for. Deleted when exchanged.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        String
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
  @@map("oauth_codes")
}

// One app a user connected: the access token it holds now (short-lived) and
// the refresh token that renews it. Both rotate on every refresh, and only
// their hashes are kept. previousRefreshTokenHash is the one just replaced:
// presented again, it means the token was copied, and the grant is revoked.
model OAuthGrant {
  id                       String      @id @default(cuid())
  userId                   String
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId                 String
  client                   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes                   String
  accessTokenHash          String      @unique
  accessExpiresAt          DateTime
  refreshTokenHash         String      @unique
  previousRefreshTokenHash String?     @unique
  refreshExpiresAt         DateTime
  lastUsedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([userId])
  @@index([clientId])
  @@map("oauth_grants")
}

// A linked bank Item. The Plaid access token is stored encrypted at rest
// (AES-256-GCM: ciphertext + iv + auth tag) and never leaves the server.
// transactionCursor tracks the position of the last /transactions/sync so each
// sync only pulls what changed since the previous one.
//
// institutionId is Plaid's stable id for the bank itself (unlike itemId, which
// is minted fresh every time the user goes through Link). It is what lets the
// exchange endpoint recognise "this is the same bank again" and replace the
// old connection instead of importing a duplicate copy of every transaction.
model BankConnection {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String        @default("plaid")
  institutionName   String?
  institutionId     String?
  itemId            String?
  encryptedToken    String
  tokenIv           String
  tokenAuthTag      String
  transactionCursor String?
  accounts          BankAccount[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([userId, institutionId])
  @@map("bank_connections")
}

model BankAccount {
  id             String            @id @default(cuid())
  connectionId   String
  connection     BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  plaidAccountId String            @unique
  name           String?
  type           String?
  lastFour       String?
  transactions   BankTransaction[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([connectionId])
  @@map("bank_accounts")
}

model BankTransaction {
  id              String      @id @default(cuid())
  accountId       String
  account         BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidTxnId      String      @unique
  date            DateTime
  description     String?
  amount          Decimal     @db.Decimal(10, 2)
  category        String?
  // What the month's Gemini categorization pass filed this under for the
  // budget ring. The original category above is kept as the bank sent it.
  budgetCategory  String?
  // Marked by the user in the budgeting view so a whole transaction (e.g. a
  // dinner out) counts toward the education-expense food total.
  isFood          Boolean     @default(false)
  linkedReceiptId String?     @unique
  linkedReceipt   Receipt?    @relation(fields: [linkedReceiptId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([accountId])
  @@map("bank_transactions")
}

model Receipt {
  id                String           @id @default(cuid())
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  storeName         String?
  receiptDate       DateTime?
  receiptNumber     String?
  category          String           @default("Other")
  // See BankTransaction.budgetCategory.
  budgetCategory    String?
  subtotal          Decimal?         @db.Decimal(10, 2)
  tax               Decimal?         @db.Decimal(10, 2)
  total             Decimal?         @db.Decimal(10, 2)
  ocrProvider       String?
  ocrConfidence     Decimal?         @db.Decimal(5, 2)
  rawOcrText        String?
  ocrDocument       Json?
  imageUrl          String?
  // The receipt photo itself, kept with the row so it lives and dies with the
  // receipt (no separate upload directory to back up or clean). Base64 without
  // the data: prefix; imageMimeType doubles as the "has an image" flag, so
  // queries can omit the heavy column and still know a photo exists.
  imageData         String?
  imageMimeType     String?
  lines             ReceiptLine[]
  people            Person[]
  shares            ReceiptShare[]
  linkedTransaction BankTransaction?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@map("receipts")
}

// A public link to one receipt, readable by anyone holding it until expiresAt.
// Only the token's hash is kept, as with a session, so the table alone cannot
// open a receipt. Expired rows are never served and are swept on the next share.
// canEdit lets whoever holds the link change the items, tax and split as well.
model ReceiptShare {
  id        String   @id @default(cuid())
  receiptId String
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  canEdit   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([receiptId])
  @@index([expiresAt])
  @@map("receipt_shares")
}

model ReceiptLine {
  id                   String           @id @default(cuid())
  receiptId            String
  receipt              Receipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  label                String
  amount               Decimal          @db.Decimal(10, 2)
  confidence           Decimal?         @db.Decimal(5, 2)
  ignored              Boolean          @default(false)
  isFood               Boolean          @default(false)
  ocrLineId            String?
  boundingBox          Json?
  sortOrder            Int              @default(0)
  // The SKU/PLU the receipt printed beside the item. Store-internal and
  // meaningless on its own, but it is the one token on the line that names the
  // product unambiguously, so it is what an identification is filed under.
  itemCode             String?
  // What this line actually was. Receipts print shorthand, and a split
  // reopened months later is unreadable when nobody can tell which line was
  // the cheese. All nullable: a line nobody has identified is a valid state.
  resolvedName         String?
  resolvedBrand        String?
  resolvedSize         String?
  // 0..1. Decimal rather than float because it is shown as a percentage and
  // compared against thresholds, and neither wants binary rounding surprises.
  resolvedConfidence   Decimal?         @db.Decimal(3, 2)
  // "user-confirmed" | "saved-alias" | "dictionary" | "ai" | "unresolved".
  resolvedSource       String?
  resolvedReasoning    String?
  // Runners-up as [{ name, confidence }]. JSON because they are read and
  // written whole and never queried across.
  resolvedAlternatives Json?
  resolvedAt           DateTime?
  assignments          LineAssignment[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([receiptId])
  @@index([receiptId, isFood])
  @@index([receiptId, resolvedName])
  @@map("receipt_lines")
}

// A name the user confirmed for an abbreviated receipt item.
//
// The memory that makes identification cheap: a correction made once never has
// to be made again, and on the next receipt from the same shop it costs
// nothing -- no model call, no wait, and full confidence, because a human
// wrote it rather than a model guessing.
model ItemAlias {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "code:<sku>" where the receipt printed one, otherwise the normalized
  // label. A code outlives the shorthand beside it, so it is preferred.
  lookupKey      String
  // The store it was learned at, lowercased, or "" when there was no store
  // name. The same shorthand means different things at different chains.
  storeKey       String   @default("")
  resolvedName   String
  brand          String?
  size           String?
  // How many times a human has agreed. A name confirmed on three receipts
  // carries more weight than one accepted in passing.
  timesConfirmed Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, storeKey, lookupKey])
  @@index([userId])
  @@map("item_aliases")
}

model AccountPerson {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(200)
  // The account owner's own entry, so a receipt can be split with themselves as
  // one of the participants and only their share counts toward their budget.
  // Exactly one per user, created on demand and not deletable.
  isSelf    Boolean  @default(false)
  people    Person[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isSelf])
  @@map("account_people")
}

model Person {
  id              String           @id @default(cuid())
  receiptId       String
  receipt         Receipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  accountPersonId String
  accountPerson   AccountPerson    @relation(fields: [accountPersonId], references: [id], onDelete: Cascade)
  assignments     LineAssignment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([receiptId, accountPersonId])
  @@index([receiptId])
  @@index([accountPersonId])
  @@map("people")
}

model LineAssignment {
  id        String      @id @default(cuid())
  lineId    String
  line      ReceiptLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  personId  String
  person    Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  mode      String      @default("equal")
  value     Decimal     @default(0) @db.Decimal(10, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([lineId, personId])
  @@index([lineId])
  @@index([personId])
  @@map("line_assignments")
}

// One rate limit window, keyed "<bucket>:<client>". Shared by every instance,
// because in-memory counters reset on each serverless cold start (see
// server/rate-limit-db.mjs). Rows are disposable.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}

model RentEntry {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year              Int
  month             Int
  amount            Decimal  @db.Decimal(10, 2)
  propertyName      String?
  date              DateTime
  photoData         String?
  photoMimeType     String?
  // Set when the entry was created straight from a bank transaction in the
  // budgeting view. It is what lets that row keep showing "Rent" after a
  // reload, and what the "remove rent payment" action looks the entry up by.
  bankTransactionId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("rent_entries")
}
