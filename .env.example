# Rename this file to .env and fill in your own values.

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Access ---
# Two tiers of account. Admin accounts may use GEMINI_API_KEY above, connect a
# bank through Plaid, and attach receipts and rent to bank transactions. Every
# other account parses receipts with a personal Gemini key saved in Settings,
# splits and saves receipts, and tracks education expenses (food lines, rent
# entries) by hand. Comma-separated, case-insensitive.
ADMIN_EMAILS=
# Who else may hold an account. Admins are always allowed and need not be
# repeated. With this set (or ADMIN_EMAILS alone), anyone not listed is
# refused at sign-up and login, and any session they already hold stops
# working. Leave both blank locally for open sign-up.
ALLOWED_LOGIN_EMAILS=
# "true" opens sign-up to anyone (as a regular account) whatever the lists say.
# Production (NODE_ENV=production, or any Vercel deployment) refuses to start
# unless at least one address is listed above or this is set: a public URL
# that anyone could sign up to by accident is not an acceptable default.
# ALLOW_PUBLIC_SIGNUP=true
#
# Example, one admin and two invited accounts:
#   ADMIN_EMAILS=you@example.com
#   ALLOWED_LOGIN_EMAILS=friend@example.com,partner@example.com

# --- Server ---
PORT=4173
# Set when running behind a reverse proxy (nginx, a PaaS load balancer, ...) so
# the client IP used for rate limiting is read from X-Forwarded-For. Use "true"
# or a trusted hop count (e.g. "1"). Leave unset when directly exposed. On
# Vercel it defaults to 1 automatically.
TRUST_PROXY=

# --- Auth & secret storage ---
# Both values below must be replaced before the server will start. Generate
# each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Random secret used to sign/verify session material.
AUTH_SESSION_SECRET=replace_me_with_a_generated_base64_secret
# 32-byte base64 key used to AES-256-GCM encrypt Plaid access tokens and saved
# Gemini keys at rest. Keep this stable — rotating it makes existing encrypted
# values undecryptable (users must reconnect their bank / re-enter their key).
TOKEN_ENCRYPTION_KEY=replace_me_with_a_generated_base64_32_byte_key

# --- Plaid (read-only bank connection) ---
# "sandbox" uses fake credentials/data. Switch to "production" (real banks) by
# changing PLAID_ENV and using the matching secret — no code change required.
# Get your keys from the Plaid dashboard.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# --- Database ---
# Matches the local Postgres started by `npm run db:up` (docker-compose.yml).
# To scale, point this at a managed Postgres (Supabase, Neon, RDS, ...) — no
# code changes needed. On Supabase use the transaction pooler (port 6543).
DATABASE_URL="postgresql://receipt:receipt@localhost:5433/receipt_ring?schema=public"
# Migrations cannot run through a transaction-mode connection pooler (Supabase's
# or Neon's pooled endpoint, PgBouncer). When DATABASE_URL is a pooled URL, put
# the direct or session-mode one here for `prisma migrate` (on Supabase: the
# session pooler, port 5432).
# DIRECT_DATABASE_URL=
#
# The Vercel Postgres and Supabase marketplace integrations set POSTGRES_URL
# (pooled) and POSTGRES_URL_NON_POOLING / DATABASE_URL_UNPOOLED instead; both
# are picked up automatically when the variables above are unset.
