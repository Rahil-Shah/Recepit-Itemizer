{
  "name": "receipt-ring",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal receipt itemizer and spending category ring.",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "vercel-build": "prisma generate && prisma migrate deploy && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "build:tests": "tsc -p tests/tsconfig.json",
    "test": "npm run build:tests && node --test tests/*.test.mjs",
    "prisma:generate": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "serve": "prisma generate && node server.mjs",
    "start": "npm run build && node server.mjs",
    "dev": "node --watch server.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.21.0",
    "prisma": "^7.8.0"
  }
}
