{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 120,
      "includeFiles": "server/fonts/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/index" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/index" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/index" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/index" },
    { "source": "/r/:token", "destination": "/shared.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
